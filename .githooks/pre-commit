#!/bin/sh
# Copies the VAG Scope changelog and privacy policies from the app repo
# (../io.mtmagicapps.vagscope) into vag-scope/, then runs the site build
# (French pages, SEO tags, sitemap) and stages whatever changed.
# Enable once per clone: git config core.hooksPath .githooks

root=$(git rev-parse --show-toplevel) || exit 1
src="$root/../io.mtmagicapps.vagscope"

build() {
  if ! command -v node >/dev/null 2>&1; then
    echo "pre-commit: node not found, run node tools/build.mjs before pushing" >&2
    return
  fi
  out=$(node "$root/tools/build.mjs") || exit 1
  printf '%s\n' "$out" | while IFS= read -r f; do
    if [ -n "$f" ]; then git add -- "$root/$f" && echo "pre-commit: built $f"; fi
  done
}

if [ ! -d "$src" ]; then
  echo "pre-commit: $src not found, skipping VAG Scope sync" >&2
  build
  exit 0
fi

dest="$root/vag-scope"

sync_file() { # <source path relative to app repo> <destination file name>
  if [ ! -f "$src/$1" ]; then
    echo "pre-commit: missing $src/$1, skipped" >&2
    return
  fi
  if ! cmp -s "$src/$1" "$dest/$2"; then
    cp "$src/$1" "$dest/$2" && git add -- "vag-scope/$2"
    echo "pre-commit: updated vag-scope/$2"
  fi
}

sync_file docs/CHANGELOG.md CHANGELOG.md
sync_file app/src/main/assets/legal/privacy_en.md privacy_en.md
sync_file app/src/main/assets/legal/privacy_fr.md privacy_fr.md
# sync_file app/src/main/assets/legal/terms_en.md terms_en.md
# sync_file app/src/main/assets/legal/terms_fr.md terms_fr.md

build
exit 0
